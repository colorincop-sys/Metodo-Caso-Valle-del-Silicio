// ALGORITMO: Sistema_Mezcla_Aleatoria_Valle_Silicio
// OBJETIVO: Optimizar la aleatoriedad en la gestión de listas de reproducción.
// AUTOR: Corin Merino Castro

    // DECLARACIÓN DE CONSTANTES (Buenas prácticas de programación)
    CONSTANTE ENTERO MAX_CANCIONES = 100

    // DECLARACIÓN DE VARIABLES GLOBALES (Ámbito global)
    CADENA lista_canciones[MAX_CANCIONES]
    ENTERO total_canciones = 0
    ENTERO opcion_menu = 0

INICIO
    // BUCLE PRINCIPAL DE LA INTERFAZ
    REPETIR
        // REPRESENTACIÓN VISUAL DE LA GUI (Salida de información)
        ESCRIBIR "----------------------------------"
        ESCRIBIR "  SISTEMA DE MEZCLA DE CANCIONES  "
        ESCRIBIR "----------------------------------"
        ESCRIBIR "1. Introducir número de canciones"
        ESCRIBIR "2. Introducir canciones"
        ESCRIBIR "3. Mezclar canciones"
        ESCRIBIR "4. Mostrar lista"
        ESCRIBIR "5. Salir"
        ESCRIBIR "----------------------------------"
        ESCRIBIR "Seleccione una opción: "
        LEER opcion_menu

        SEGÚN opcion_menu HACER
            
            CASO 1: // Fase de Análisis/Entrada
                ESCRIBIR "Indique cuántas canciones desea gestionar (Máx 100): "
                LEER total_canciones
                SI (total_canciones < 1 O total_canciones > MAX_CANCIONES) ENTONCES
                    ESCRIBIR "Error: Cantidad no válida."
                    total_canciones = 0
                FIN_SI

            CASO 2: // Llenado de datos
                SI (total_canciones > 0) ENTONCES
                    PARA i DESDE 0 HASTA total_canciones - 1 HACER
                        ESCRIBIR "Nombre de la canción ", i + 1, ": "
                        LEER lista_canciones[i]
                    FIN_PARA
                SINO
                    ESCRIBIR "Primero debe indicar el número de canciones (Opción 1)."
                FIN_SI

            CASO 3: // PROCESO: Algoritmo de mezcla (Shuffle)
                SI (total_canciones > 1) ENTONCES
                    // Implementación lógica basada en el intercambio aleatorio
                    PARA i DESDE total_canciones - 1 HASTA 1 HACER
                        ENTERO j = ALEATORIO(0, i) // Genera índice aleatorio
                        // Operación de intercambio (Swap)
                        CADENA temporal = lista_canciones[i]
                        lista_canciones[i] = lista_canciones[j]
                        lista_canciones[j] = temporal
                    FIN_PARA
                    ESCRIBIR "¡Mezcla completada con éxito!"
                SINO
                    ESCRIBIR "No hay suficientes canciones para mezclar."
                FIN_SI

            CASO 4: // Salida de información (Despliegue)
                SI (total_canciones > 0) ENTONCES
                    ESCRIBIR "--- LISTA ACTUAL DE REPRODUCCIÓN ---"
                    PARA i DESDE 0 HASTA total_canciones - 1 HACER
                        ESCRIBIR i + 1, ". ", lista_canciones[i]
                    FIN_PARA
                SINO
                    ESCRIBIR "La lista está vacía."
                FIN_SI

            CASO 5:
                ESCRIBIR "Saliendo del sistema..."

            DE OTRO MODO:
                ESCRIBIR "Opción no válida, intente de nuevo."

        FIN_SEGÚN

    HASTA QUE opcion_menu == 5

FIN_ALGORITMO
